{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@luolapeikko/factory-logger",
  "version": "0.1.0",
  "description": "Factory logger implementation for TypeScript.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean -c tsconfig.build.json",
    "validate": "tsc --noEmit"
  },
  "files": ["dist"],
  "repository": "github:luolapeikko/logger-suite",
  "keywords": ["logger", "typescript", "winston", "log4js", "console"],
  "author": "luolapeikko",
  "license": "MIT",
  "devDependencies": {
    "@luolapeikko/key-logger": "workspace:*",
    "@luolapeikko/level-logger": "workspace:*",
    "@luolapeikko/logger-type": "workspace:*",
    "@luolapeikko/loglevel-type": "workspace:*",
    "@luolapeikko/prefix-logger": "workspace:*"
  },
  "peerDependencies": {
    "@luolapeikko/key-logger": ">= 0.1.0",
    "@luolapeikko/level-logger": ">= 0.1.0",
    "@luolapeikko/logger-type": ">= 0.1.0",
    "@luolapeikko/loglevel-type": ">= 0.1.0",
    "@luolapeikko/prefix-logger": ">= 0.1.0"
  }
}
